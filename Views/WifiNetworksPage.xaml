<Page x:Class="RbnSystemPro.Views.WifiNetworksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="WiFi Networks">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,40,28,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                 <ui:Button Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Secondary" Margin="0,0,16,0" Click="OnBackClick" VerticalAlignment="Center"/>
                 <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Text="WiFi Networks" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="Available wireless networks in your area." Appearance="Secondary" FontSize="14" Margin="0,4,0,0"/>
                 </StackPanel>
            </StackPanel>
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" 
                       Icon="{ui:SymbolIcon ArrowSync24}" 
                       Content="Refresh"
                       Command="{Binding ViewModel.RefreshNetworksCommand}"/>
        </Grid>

        <!-- Sticky Connected Network -->
        <ui:Card Grid.Row="1" Margin="28,0,28,16" Padding="16" Background="#1528A745" BorderBrush="#28A745" BorderThickness="1"
                 Visibility="{Binding ViewModel.IsWifiConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
             <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Wifi124" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#28A745"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding ViewModel.ConnectedWifiSsid}" FontSize="16" FontWeight="Bold"/>
                    <ui:TextBlock Text="Connected" FontSize="12" Foreground="#28A745" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="{ui:SymbolIcon PlugDisconnected24}" Appearance="Secondary" Margin="0,0,8,0"
                               Command="{Binding ViewModel.DisconnectCommand}" ToolTip="Disconnect" Foreground="#DC3545"/>
                    <ui:Button Icon="{ui:SymbolIcon Info24}" Appearance="Secondary"
                               Command="{Binding ViewModel.ShowWifiPasswordCommand}" ToolTip="Show Password"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,0,28,40">
                <!-- WiFi Networks List -->
                <ItemsControl ItemsSource="{Binding ViewModel.WifiNetworks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="WifiWarning24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <ui:TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                                    <ui:Button Grid.Column="2" Content="Connect" Appearance="Primary" Padding="20,6"
                                               Command="{Binding DataContext.ViewModel.ShowConnectionModalCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Connection Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Visibility="{Binding ViewModel.IsModalVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ui:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel>
                    <ui:TextBlock Text="Connect to Network" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ui:TextBlock Text="{Binding ViewModel.SelectedSsid}" FontSize="14" Appearance="Secondary" Margin="0,0,0,24"/>

                    <ui:TextBlock Text="Password" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <ui:PasswordBox x:Name="WifiPasswordBox" PasswordChar="*" IsEnabled="True" />
                    </Grid>

                    <CheckBox Content="Connect automatically" IsChecked="{Binding ViewModel.AutoConnect}" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="Cancel" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                   Command="{Binding ViewModel.CancelConnectionCommand}"/>
                        <ui:Button Grid.Column="1" Content="Connect" Margin="4,0,0,0" Appearance="Primary" HorizontalAlignment="Stretch"
                                   Click="OnConnectBtnClick"/>
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Password Info Modal Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" Visibility="{Binding ViewModel.IsPasswordInfoModalVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
             <ui:Card Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel>
                    <ui:TextBlock Text="Network Information" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                    
                    <ui:TextBlock Text="SSID" FontSize="12" Opacity="0.7"/>
                    <ui:TextBlock Text="{Binding ViewModel.ConnectedWifiSsid}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <ui:TextBlock Text="Password" FontSize="12" Opacity="0.7"/>
                    <ui:TextBox Text="{Binding ViewModel.CurrentWifiPassword}" IsReadOnly="True" Margin="0,0,0,24"/>

                    <ui:Button Content="Close" HorizontalAlignment="Stretch" Appearance="Primary"
                               Command="{Binding ViewModel.ClosePasswordInfoCommand}"/>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
