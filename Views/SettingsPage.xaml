<Page x:Class="RbnSystemPro.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:RbnSystemPro.Helpers"
      xmlns:helpers="clr-namespace:RbnSystemPro.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Settings">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,40,28,40">
                <!-- Header -->
                <StackPanel Margin="0,0,0,32">
                    <ui:TextBlock Text="{l:T settings.title}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="{l:T settings.subtitle}" Appearance="Secondary" FontSize="14" Opacity="0.6"/>
                </StackPanel>

                <!-- Update Section -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" Background="#100078D7" CornerRadius="12" Margin="0,0,20,0">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="26" Foreground="#0078D7"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="{l:T settings.softwareUpdates}" FontSize="18" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ui:TextBlock Text="{l:T settings.currentVersion}" Opacity="0.5" FontSize="12" Margin="0,0,4,0"/>
                                <ui:TextBlock Text="{x:Static helpers:GlobalConfig.AppVersion}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button x:Name="CheckUpdateButton" 
                                   Grid.Column="2" 
                                   Content="{l:T settings.checkUpdates}" 
                                   Appearance="Primary" 
                                   Padding="20,8"
                                   Click="OnCheckUpdateClick"/>
                    </Grid>
                </ui:Card>

                <!-- GitHub Integration Card -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <ui:TextBlock Text="{l:T settings.distribution}" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Link24" FontSize="20" Margin="0,0,16,0" Opacity="0.7"/>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="{l:T settings.githubRepo}" FontWeight="SemiBold"/>
                                <ui:TextBlock Text="{l:T settings.githubDesc}" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- General Preferences -->
                <ui:TextBlock Text="{l:T settings.general}" FontSize="11" FontWeight="Bold" Opacity="0.8" Margin="4,16,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                
                <ui:Card Padding="16,4" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- DAPP-41: dil seçici. Varsayılan "Sistem dili" (Windows görüntü dili). -->
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <ui:TextBlock Text="{l:T settings.language}" FontWeight="Medium"/>
                                <ui:TextBlock Text="{l:T settings.languageDesc}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="LanguageComboBox" MinWidth="220" VerticalAlignment="Center"
                                      SelectionChanged="OnLanguageChanged">
                                <ComboBoxItem Content="{l:T settings.language.system}"/>
                                <ComboBoxItem Content="{l:T settings.language.turkish}"/>
                                <ComboBoxItem Content="{l:T settings.language.english}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="#08FFFFFF"/>

                        <Grid Margin="0,12">
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="{l:T settings.clearLogs}" FontWeight="Medium"/>
                                <ui:TextBlock Text="{l:T settings.clearLogsDesc}" FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                            <ui:Button Content="{l:T settings.clearLogsButton}" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearLogsClick"/>
                        </Grid>
                        
                        <Separator Background="#08FFFFFF"/>

                        <Grid Margin="0,12">
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="{l:T settings.hwMonitoring}" FontWeight="Medium"/>
                                <ui:TextBlock Text="{l:T settings.hwMonitoringDesc}" FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="HardwareMonitoringSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- About Card -->
                <ui:Card Padding="24" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                    <StackPanel>
                        <ui:TextBlock Text="{l:T settings.about}" FontSize="11" FontWeight="Bold" Opacity="0.8" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock Text="{x:Static helpers:GlobalConfig.FullTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBlock Text="{l:T settings.aboutDesc}"
                                      FontSize="13" Opacity="0.8" TextWrapping="Wrap" LineHeight="20"/>
                        <!-- Üçüncü taraf atıf: Windows Deploy, Raphire/Win11Debloat (MIT) betiğini kullanır.
                             Adres GlobalConfig.Win11DebloatUrl'te tek yerde; bağlantı varsayılan tarayıcıda açılır. -->
                        <WrapPanel Margin="0,10,0,0">
                            <ui:TextBlock Text="{l:T settings.deployPrefix}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                            <ui:HyperlinkButton Content="Raphire/Win11Debloat" Padding="0" FontSize="12" VerticalAlignment="Center" Click="OnWin11DebloatLinkClick"/>
                            <ui:TextBlock Text="{l:T settings.deploySuffix}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:HyperlinkButton Content="{l:T settings.viewGithub}" Padding="0" Margin="0,0,16,0" Click="OnGitHubLinkClick"/>
                            <!-- Geri bildirim: varsayılan tarayıcıda GitHub'ın yeni issue sayfası (yalnız sürüm + Windows sürümü ön dolu) -->
                            <ui:Button x:Name="FeedbackButton"
                                       Content="{l:T settings.feedback}"
                                       Appearance="Secondary"
                                       Padding="14,6"
                                       Click="OnFeedbackClick"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
