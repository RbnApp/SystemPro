<Page x:Class="RbnSystemPro.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:RbnSystemPro.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Settings">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,40,28,40">
                <!-- Header -->
                <StackPanel Margin="0,0,0,32">
                    <ui:TextBlock Text="Application Settings" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:TextBlock Text="Configure and update yours system deployment tool." Appearance="Secondary" FontSize="14" Opacity="0.6"/>
                </StackPanel>

                <!-- Update Section -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" Background="#100078D7" CornerRadius="12" Margin="0,0,20,0">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="26" Foreground="#0078D7"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="Software Updates" FontSize="18" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <ui:TextBlock Text="Current Version:" Opacity="0.5" FontSize="12" Margin="0,0,4,0"/>
                                <ui:TextBlock Text="{x:Static helpers:GlobalConfig.AppVersion}" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button x:Name="CheckUpdateButton" 
                                   Grid.Column="2" 
                                   Content="Check for Updates" 
                                   Appearance="Primary" 
                                   Padding="20,8"
                                   Click="OnCheckUpdateClick"/>
                    </Grid>
                </ui:Card>

                <!-- GitHub Integration Card -->
                <ui:Card Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <ui:TextBlock Text="DISTRIBUTION SOURCE" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Link24" FontSize="20" Margin="0,0,16,0" Opacity="0.7"/>
                            <StackPanel Grid.Column="1">
                                <ui:TextBlock Text="GitHub Repository" FontWeight="SemiBold"/>
                                <ui:TextBlock Text="Updates are checked against the latest GitHub Release tags." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- General Preferences -->
                <ui:TextBlock Text="GENERAL PREFERENCES" FontSize="11" FontWeight="Bold" Opacity="0.8" Margin="4,16,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                
                <ui:Card Padding="16,4" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="Clear Activity Logs" FontWeight="Medium"/>
                                <ui:TextBlock Text="Permanently delete all stored activity history." FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                            <ui:Button Content="Clear Logs" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnClearLogsClick"/>
                        </Grid>
                        
                        <Separator Background="#08FFFFFF"/>

                        <Grid Margin="0,12">
                            <StackPanel VerticalAlignment="Center">
                                <ui:TextBlock Text="Hardware Monitoring" FontWeight="Medium"/>
                                <ui:TextBlock Text="Enable deep WMI sensor scanning for better accuracy." FontSize="12" Opacity="0.5"/>
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="HardwareMonitoringSwitch" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- About Card -->
                <ui:Card Padding="24" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                    <StackPanel>
                        <ui:TextBlock Text="ABOUT RBNSYSTEMPRO" FontSize="11" FontWeight="Bold" Opacity="0.8" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBlock Text="{x:Static helpers:GlobalConfig.FullTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBlock Text="RbnSystemPro is a high-performance system configuration and optimization engine designed for modern Windows environments."
                                      FontSize="13" Opacity="0.8" TextWrapping="Wrap" LineHeight="20"/>
                        <!-- Üçüncü taraf atıf: Windows Deploy, Raphire/Win11Debloat (MIT) betiğini kullanır.
                             Adres GlobalConfig.Win11DebloatUrl'te tek yerde; bağlantı varsayılan tarayıcıda açılır. -->
                        <WrapPanel Margin="0,10,0,0">
                            <ui:TextBlock Text="Windows Deploy uses the " FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                            <ui:HyperlinkButton Content="Raphire/Win11Debloat" Padding="0" FontSize="12" VerticalAlignment="Center" Click="OnWin11DebloatLinkClick"/>
                            <ui:TextBlock Text=" (MIT) script." FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:HyperlinkButton Content="View on GitHub" Padding="0" Margin="0,0,16,0" Click="OnGitHubLinkClick"/>
                            <!-- Geri bildirim: varsayılan tarayıcıda GitHub'ın yeni issue sayfası (yalnız sürüm + Windows sürümü ön dolu) -->
                            <ui:Button x:Name="FeedbackButton"
                                       Content="Geri bildirim gönder"
                                       Appearance="Secondary"
                                       Padding="14,6"
                                       Click="OnFeedbackClick"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
