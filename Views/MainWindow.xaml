<ui:FluentWindow x:Class="RbnSystemPro.Views.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:local="clr-namespace:RbnSystemPro.Views"
                xmlns:controls="clr-namespace:RbnSystemPro.Controls"
                xmlns:helpers="clr-namespace:RbnSystemPro.Helpers"
                mc:Ignorable="d"
                Title="{Binding AppTitle}"
                Height="820" Width="1200"
                WindowStartupLocation="CenterScreen"
                ResizeMode="NoResize"
                ExtendsContentIntoTitleBar="False"
                WindowBackdropType="None"
                Icon="/Assets/app_icon.png"
                Background="{DynamicResource ApplicationBackgroundBrush}">
    
    <Window.Resources />

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar Row -->
            <RowDefinition Height="*" />    <!-- Content Row -->
        </Grid.RowDefinitions>

        <!-- Global TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding AppTitle, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" />

        <!-- Main Layout (Row 1) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />   <!-- Flexible Content Area -->
                <ColumnDefinition Width="340" /> <!-- Fixed System Analysis -->
            </Grid.ColumnDefinitions>

            <!-- Main Content Area -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                     <RowDefinition Height="Auto"/>
                     <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Navigation Bar (Replaces Sidebar) -->
                <Grid Grid.Row="0" Margin="24,12,24,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                         <ui:Button Icon="{ui:SymbolIcon Home24}" 
                                    Content="Home" 
                                    Click="OnHomeButtonClick" 
                                    Margin="0,0,4,0" 
                                    Appearance="Transparent"
                                    Padding="12,8"/>
                         
                         <ui:Button Icon="{ui:SymbolIcon History24}" 
                                    Content="Activity" 
                                    Click="OnActivityButtonClick" 
                                    Margin="0,0,4,0" 
                                    Appearance="Transparent"
                                    Padding="12,8"/>

                         <ui:Button Icon="{ui:SymbolIcon Settings24}" 
                                    Content="Settings" 
                                    Click="OnSettingsButtonClick" 
                                    Margin="0,0,0,0"
                                    Appearance="Transparent"
                                    Padding="12,8"/>
                    </StackPanel>

                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="Circle20" FontSize="11" Margin="0,1,6,0" Foreground="LimeGreen" VerticalAlignment="Center"/>
                        <ui:TextBlock Grid.Column="1" Text="SYSTEM READY" FontSize="10" FontWeight="Bold" Opacity="0.8" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" 
                        Margin="10,0,10,10" 
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        ClipToBounds="True">
                    <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" />
                </Border>
            </Grid>

            <!-- Right Side: System Analysis Panel -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,24,16,24">
                        <ui:TextBlock Text="System Analysis" 
                                     FontWeight="Bold" 
                                     FontSize="22" 
                                     Margin="4,0,0,24"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        
                        <!-- CPU Section -->
                        <Border Margin="0,0,0,12" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                            <StackPanel>
                                <ui:TextBlock Text="PROCESSOR" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,6" />
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.CpuName, FallbackValue='Detecting...'}" 
                                             FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                <ui:TextBlock Text="{Binding ViewModel.CpuCoreInfo}" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Section -->
                        <Border Margin="0,0,0,12" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                            <StackPanel>
                                <ui:TextBlock Text="GRAPHICS" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,6" />
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.GpuName, FallbackValue='Detecting...'}" 
                                             FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.GpuMemory}" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Motherboard Section -->
                        <Border Margin="0,0,0,12" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                            <StackPanel>
                                <ui:TextBlock Text="MOTHERBOARD" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,6" />
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.Motherboard, FallbackValue='Detecting...'}" 
                                             FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.BiosVersion, StringFormat='Version: {0}'}" FontSize="12" Opacity="0.8" Margin="0,4,0,0"/>
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.BiosDate, StringFormat='Date: {0}'}" FontSize="12" Opacity="0.6" Margin="0,2,0,0"/>
                                
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <ui:Button Content="Check Update" 
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Command="{Binding ViewModel.CheckBiosUpdateCommand}"
                                               HorizontalAlignment="Left"
                                               Appearance="Secondary" />

                                    <ui:Button Grid.Column="1" 
                                               Content="Download" 
                                               Icon="{ui:SymbolIcon ArrowDownload24}"
                                               Command="{Binding ViewModel.DownloadBiosCommand}"
                                               Visibility="{Binding ViewModel.HardwareInfo.IsBiosUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Appearance="Primary" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RAM Section -->
                        <Border Margin="0,0,0,12" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                            <StackPanel>
                                <ui:TextBlock Text="MEMORY" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,6" />
                                <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.RamTotal, FallbackValue='Detecting...'}" 
                                             FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding ViewModel.HardwareInfo.RamSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="12" Margin="0,0,8,0" Opacity="0.5"/>
                                                <ui:TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Opacity="0.8"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Health Section -->
                        <Border Margin="0,0,0,24" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.HardwareInfo.CpuTemperature}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ViewModel.HardwareInfo.CpuTemperature}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel HorizontalAlignment="Left">
                                    <ui:TextBlock Text="CPU TEMPERATURE" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,6" />
                                    <ui:TextBlock FontWeight="Bold" FontSize="18" Foreground="{DynamicResource SystemFillColorCautionBrush}">
                                        <Run Text="{Binding ViewModel.HardwareInfo.CpuTemperature, StringFormat='{}{0:F1}°C', FallbackValue='--'}" />
                                    </ui:TextBlock>
                                </StackPanel>
                                <ui:SymbolIcon Symbol="Temperature24" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="28" Opacity="0.2" />
                            </Grid>
                        </Border>

                        <Separator Margin="0,2,0,4" Opacity="0.3"/>

                        <!-- Activation Section -->
                        <ui:TextBlock Text="WINDOWS LICENSE" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="4,0,0,8" />
                        <Border Background="{Binding ViewModel.HardwareInfo.IsWindowsActivated, Converter={StaticResource BooleanToActivationBgConverter}}"
                                Padding="16"
                                CornerRadius="12">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <ui:SymbolIcon Grid.Column="0" 
                                               Symbol="{Binding ViewModel.HardwareInfo.IsWindowsActivated, Converter={StaticResource BooleanToIconConverter}, FallbackValue='ShieldError24'}" 
                                               FontSize="32" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.IsWindowsActivated, Converter={StaticResource BooleanToActivationTextConverter}}" 
                                                 FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" TextAlignment="Center"/>

                                    <ui:TextBlock Text="{Binding ViewModel.HardwareInfo.WindowsEdition}" 
                                                 FontSize="11" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
                                    
                                    <ui:Button Content="Activate Now" 
                                               Command="{Binding ViewModel.ActivateCommand}"
                                               Visibility="{Binding ViewModel.HardwareInfo.IsWindowsActivated, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                               Appearance="Primary"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Global Loading Overlay -->
        <controls:LoadingOverlay Grid.Row="1" Grid.RowSpan="2" 
                              Panel.ZIndex="9999"
                              Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

        <!-- Content Dialog Host -->
        <ui:ContentDialogHost x:Name="RootContentDialogPresenter" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
