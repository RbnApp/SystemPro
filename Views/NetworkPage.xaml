<Page x:Class="RbnSystemPro.Views.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="Network Optimizer">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,40,28,40">
                <!-- Header -->
                <Grid Margin="0,0,0,32">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ui:TextBlock Text="Network Optimizer" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock Text="Optimize your internet connection and DNS settings for better performance." 
                                     Appearance="Secondary" FontSize="14" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#00B294" CornerRadius="6" Padding="12,6" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding ViewModel.ConnectionType, Converter={StaticResource ConnectionTypeToIconConverter}}" 
                                               Margin="0,0,8,0" VerticalAlignment="Center" FontSize="18" Foreground="White"/>
                                <ui:TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White">
                                    <Run Text="{Binding ViewModel.ConnectionType}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding ViewModel.ConnectionName}"/>
                                </ui:TextBlock>
                            </StackPanel>
                        </Border>
                        
                        <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" 
                                   Command="{Binding ViewModel.RefreshNetworksCommand}"
                                   Appearance="Transparent"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- WiFi Networks Section -->
                <StackPanel>
                    <ui:CardAction Icon="WifiSettings24" 
                                  IsChevronVisible="True"
                                  Click="OnViewWifiNetworksClick"
                                  Margin="0,0,0,32">
                        <StackPanel>
                            <ui:TextBlock Text="Available WiFi Networks" FontSize="15" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="View and connect to wireless networks nearby." FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </ui:CardAction>
                </StackPanel>

                <!-- DNS Section -->
                <ui:TextBlock Text="DNS OPTIMIZATION" FontSize="11" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,16"/>
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Globe24" FontSize="28" Foreground="#4285F4" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                            <ui:TextBlock Text="Google DNS" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="8.8.8.8 / 8.8.4.4" FontSize="12" Opacity="0.7" Margin="0,0,0,16"/>
                            <ui:Button Content="Apply Google DNS" 
                                       Command="{Binding ViewModel.SetGoogleDnsCommand}"
                                       Appearance="Primary" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="16">
                        <StackPanel>
                            <ui:SymbolIcon Symbol="Cloud24" FontSize="28" Foreground="#F38020" Margin="0,0,0,12" HorizontalAlignment="Left"/>
                            <ui:TextBlock Text="Cloudflare DNS" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBlock Text="1.1.1.1 / 1.0.0.1" FontSize="12" Opacity="0.7" Margin="0,0,0,16"/>
                            <ui:Button Content="Apply Cloudflare DNS" 
                                       Command="{Binding ViewModel.SetCloudflareDnsCommand}"
                                       Appearance="Primary" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <!-- Quick Actions -->
                <ui:TextBlock Text="SYSTEM ACTIONS" FontSize="11" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,16"/>
                <ui:Card Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Text="Flush DNS Cache" FontSize="15" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="Clears the resolver cache to fix connection issues." FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Execute" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding ViewModel.FlushDnsCommand}"/>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Text="Optimize TCP Stack" FontSize="15" FontWeight="SemiBold"/>
                            <ui:TextBlock Text="Adjust Windows network parameters for lower latency." FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Optimize" Icon="{ui:SymbolIcon CellularData124}" Command="{Binding ViewModel.OptimizeTcpCommand}"/>
                    </Grid>
                </ui:Card>

                <ui:Card Padding="16" Margin="0,0,0,12" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock Text="Network Stack Reset" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <ui:TextBlock Text="Resets Winsock and IP stack to factory defaults. Requires REBOOT." FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Content="Hard Reset" Appearance="Secondary" Command="{Binding ViewModel.ResetNetworkCommand}"/>
                    </Grid>
                </ui:Card>

                <!-- Footer Status -->
                <Border Margin="0,24,0,0" Padding="12" CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewModel.StatusMessage}" Value="Ready">
                                    <Setter Property="Background" Value="#28A745" /> <!-- Green -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,12,0" 
                                        Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ui:TextBlock Text="{Binding ViewModel.StatusMessage}" 
                                     VerticalAlignment="Center" 
                                     FontWeight="SemiBold"
                                     Foreground="{Binding ViewModel.StatusMessage, Converter={StaticResource StatusToForegroundConverter}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
