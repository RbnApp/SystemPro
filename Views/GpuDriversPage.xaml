<Page x:Class="RbnSystemPro.Views.GpuDriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:RbnSystemPro.Views"
      Title="GPU Drivers">

    <Page.Resources>
        <local:BoolToInstallUpdateConverter x:Key="BoolToInstallUpdateConverter"/>
        
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F111A" Offset="0"/> <!-- Deep Neural Dark -->
            <GradientStop Color="#1A1C26" Offset="1"/> <!-- Slate Dark -->
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="NvidiaGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#76B900" Offset="0"/>
            <GradientStop Color="#5a9000" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="AmdGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ED1C24" Offset="0"/>
            <GradientStop Color="#c41018" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="IntelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0071C5" Offset="0"/>
            <GradientStop Color="#005a9e" Offset="1"/>
        </LinearGradientBrush>

        <!-- Dynamic Accent Resources -->
        <SolidColorBrush x:Key="GpuAccentBrush" Color="#76B900"/>
        <SolidColorBrush x:Key="GpuAccentAlphaBrush" Color="#1A76B900"/>

        <Style x:Key="ModernTabItemStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Padding="20,12" Margin="0,0,8,0" 
                                CornerRadius="8" Background="Transparent" 
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GpuAccentAlphaBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource GpuAccentBrush}"/>
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Premium Header with Gradient -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" 
                CornerRadius="12" Padding="28,24" Margin="28,12,28,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Animated Icon Container -->
                <Border Grid.Column="0" Width="56" Height="56" 
                        x:Name="HeaderIconBorder"
                        CornerRadius="12" Margin="0,0,20,0"
                        Background="#2a2a3e">
                    <Border.Effect>
                        <DropShadowEffect x:Name="HeaderIconShadow" Color="#76B900" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <ui:SymbolIcon x:Name="HeaderIcon" Symbol="DeveloperBoard24" 
                                   FontSize="32"
                                   Foreground="#76B900"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="GPU Driver Management" 
                               FontSize="24" FontWeight="Bold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="CurrentGpuText" 
                                   Text="Loading..." 
                                   FontSize="14"
                                   Foreground="#B0B0B0"
                                   FontWeight="Medium"/>
                        <TextBlock x:Name="GpuMemoryText" 
                                   Text="" 
                                   FontSize="13" Margin="12,0,0,0"
                                   Foreground="{DynamicResource GpuAccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modern Tab Control -->
        <TabControl Grid.Row="1" x:Name="DriverTabControl" 
                    Background="Transparent" BorderThickness="0"
                    Margin="28,0,28,0">
            
            <!-- Your GPU Driver Tab -->
            <TabItem Style="{StaticResource ModernTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Your GPU Driver" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,20">
                    <StackPanel>
                        <!-- Current GPU Driver Card - Premium Design -->
                        <Border x:Name="CurrentDriverCard" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="12" Padding="28" Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Driver Info with Icon -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" x:Name="CurrentDriverIcon"
                                            Width="64" Height="64" 
                                            CornerRadius="12" Margin="0,0,20,0"
                                            Background="{StaticResource NvidiaGradient}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#76B900" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ui:SymbolIcon Symbol="DeveloperBoard24" 
                                                       FontSize="32" Foreground="White"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CurrentDriverName" 
                                                       Text="Driver Name" 
                                                       FontSize="22" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Border x:Name="CurrentDriverTypeBadge" 
                                                    Background="{DynamicResource GpuAccentAlphaBrush}" 
                                                    CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="CurrentDriverTypeText" 
                                                           Text="Game Ready" FontSize="10" FontWeight="Bold" 
                                                           Foreground="{DynamicResource GpuAccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="CurrentDriverDesc" 
                                                   Text="Description" 
                                                   FontSize="14" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Version Info Cards -->
                                <Grid Grid.Row="1" Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Installed Version Card -->
                                    <Border Grid.Column="0" 
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="INSTALLED VERSION" 
                                                       FontSize="11" FontWeight="Bold" 
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="CurrentInstalledVersion" 
                                                       Text="Not Installed" 
                                                       FontSize="20" FontWeight="Bold" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Latest Version Card -->
                                    <Border Grid.Column="2" 
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10" Padding="20,16">
                                        <StackPanel>
                                            <TextBlock Text="LATEST VERSION" 
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="CurrentLatestVersion" 
                                                       Text="Unknown" 
                                                       FontSize="20" FontWeight="Bold" Margin="0,8,0,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Status Badge - Modern Design -->
                                <Border Grid.Row="2" x:Name="CurrentStatusBadge"
                                        Background="#28A745" CornerRadius="8" 
                                        Padding="16,10" Margin="0,24,0,0"
                                        HorizontalAlignment="Left">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#28A745" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" 
                                                       Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="CurrentStatusText" 
                                                   Text="Up to Date" 
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons - Premium Style -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,24,0,0">
                                    <ui:Button x:Name="CurrentInstallButton" 
                                               Content="Install Driver" 
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon ArrowDownload24}"
                                               Click="InstallCurrentDriver_Click"
                                               Padding="20,12"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"/>
                                    <ui:Button x:Name="CurrentUpdateButton" 
                                               Content="Update Driver" 
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Click="UpdateCurrentDriver_Click"
                                               Padding="20,12"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed"
                                               Margin="0,0,12,0"/>
                                    <ui:Button x:Name="CurrentManualDownloadButton" 
                                               Content="Download Manual" 
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon Open24}"
                                               Click="DownloadDriver_Click"
                                               Padding="20,12"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"/>
                                    <ui:Button Content="Refresh Status" 
                                               Appearance="Secondary"
                                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                                               Click="RefreshDrivers_Click"
                                               Padding="20,12"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- No GPU Detected - Enhanced Design -->
                        <Border x:Name="NoGpuCard" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="12" Padding="48,40" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="3" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="80" Height="80" 
                                        CornerRadius="40" 
                                        Background="#FFF3CD"
                                        HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="40" 
                                                   Foreground="#856404"/>
                                </Border>
                                <TextBlock Text="GPU Not Detected" 
                                           FontSize="22" FontWeight="Bold" Margin="0,20,0,8"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Please check all drivers in the 'Other Drivers' tab" 
                                           FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Other Drivers Tab -->
            <TabItem Style="{StaticResource ModernTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Grid24" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Other Drivers" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,20,0,20">
                    <ItemsControl x:Name="AllDriversList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="12" Padding="28" Margin="0,0,0,16">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header with Gradient Icon -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                    Width="56" Height="56" 
                                                    CornerRadius="12" Margin="0,0,20,0"
                                                    Background="{Binding HexColor}">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{Binding HexColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                                </Border.Effect>
                                                <ui:SymbolIcon Symbol="{Binding IconSymbol}" 
                                                               FontSize="28" Foreground="White"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="18" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                    <Border Background="#1AFFFFFF" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DriverType}" FontSize="9" FontWeight="Bold" Opacity="0.7"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Manufacturer}" 
                                                           FontSize="13" Margin="0,4,0,0"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding Description}" 
                                                   FontSize="14" Margin="0,16,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="22"/>

                                        <!-- Version Info Cards -->
                                        <Grid Grid.Row="2" Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" 
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="8" Padding="16,12">
                                                <StackPanel>
                                                    <TextBlock Text="INSTALLED" 
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding InstalledVersion}" 
                                                               FontSize="16" FontWeight="Bold" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" 
                                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                    CornerRadius="8" Padding="16,12">
                                                <StackPanel>
                                                    <TextBlock Text="LATEST" 
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding LatestVersion}" 
                                                               FontSize="16" FontWeight="Bold" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Action Button -->
                                        <ui:Button Grid.Row="3" 
                                                   Content="Download Driver"
                                                   Appearance="Secondary"
                                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   Click="DownloadDriver_Click"
                                                   Tag="{Binding}"
                                                   Padding="20,12"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,16,0,0"
                                                   HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Loading Overlay - Enhanced -->
        <Border x:Name="LoadingOverlay" 
                Grid.RowSpan="2"
                Background="#CC000000" 
                CornerRadius="12"
                Visibility="Collapsed">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="16" Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="5" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <ui:ProgressRing IsIndeterminate="True" Width="56" Height="56"/>
                    <TextBlock x:Name="LoadingText" 
                               Text="Loading drivers..." 
                               FontSize="15" Margin="0,20,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Page>
