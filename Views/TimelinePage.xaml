<Page x:Class="RbnSystemPro.Views.TimelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:RbnSystemPro.Views"
      xmlns:helpers="clr-namespace:RbnSystemPro.Helpers"
      xmlns:models="clr-namespace:RbnSystemPro.Models"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Activity Timeline">

    <Page.Resources>
        <!-- Converters for iconography based on event type -->
        <helpers:EventTypeToIconConverter x:Key="EventTypeToIconConverter"/>
        <helpers:EventTypeToColorConverter x:Key="EventTypeToColorConverter"/>
    </Page.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Premium Header Area -->
        <Border Grid.Row="0" Background="#0F111A" CornerRadius="12" Padding="28,24" Margin="28,12,28,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="56" Height="56" Background="#1A76B900" CornerRadius="12" Margin="0,0,20,0">
                    <ui:SymbolIcon Symbol="History24" FontSize="32" Foreground="#76B900"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Text="System Activity Timeline" FontSize="26" FontWeight="Bold" Foreground="White" />
                    <ui:TextBlock Text="Trace of all actions performed by RbnSystemPro" FontSize="14" Opacity="0.6" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Timeline Content -->
        <Grid Grid.Row="1" Margin="28,0,28,40">
            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="History24" FontSize="64" Opacity="0.3" Margin="0,0,0,20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:TextBlock Text="No Activity Recorded Yet" 
                              FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" 
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Text="Use RbnSystemPro to install programs or optimize your system. Your history will appear here." 
                              FontSize="14" HorizontalAlignment="Center" 
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7" Margin="0,8,0,0"
                              TextAlignment="Center"/>
            </StackPanel>

            <!-- Timeline List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Vertical Connector Line -->
                    <Rectangle Width="2" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" 
                               HorizontalAlignment="Left" Margin="23,0,0,0" Opacity="0.3"/>

                    <ItemsControl x:Name="TimelineItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TimelineEvent}">
                                <Grid Margin="0,0,0,32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" /> <!-- Connector Dot Column -->
                                        <ColumnDefinition Width="*" />  <!-- Content Column -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Dot with Icon -->
                                    <Border Grid.Column="0" Width="32" Height="32" 
                                            CornerRadius="16" 
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Background="{Binding Path=Type, Converter={StaticResource EventTypeToColorConverter}}">
                                        <ui:SymbolIcon Symbol="{Binding Path=Type, Converter={StaticResource EventTypeToIconConverter}}" 
                                                       FontSize="16" Foreground="White"/>
                                    </Border>

                                    <!-- Content Card -->
                                    <ui:Card Grid.Column="1" Padding="20,16" Margin="12,0,0,0">
                                        <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             
                                             <StackPanel Grid.Column="0">
                                                 <ui:TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                                 <ui:TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                             </StackPanel>

                                             <StackPanel Grid.Column="1" VerticalAlignment="Top" Opacity="0.5">
                                                 <ui:TextBlock Text="{Binding TimeLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                 <ui:TextBlock Text="{Binding DateLabel}" FontSize="10" HorizontalAlignment="Right"/>
                                             </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
