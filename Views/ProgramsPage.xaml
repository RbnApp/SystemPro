<Page x:Class="RbnSystemPro.Views.ProgramsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:RbnSystemPro.Helpers"
      xmlns:local="clr-namespace:RbnSystemPro.Views"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="ProgramsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,24,24,12">
            <StackPanel Orientation="Vertical">
                <ui:TextBlock Text="{l:T programs.title}" FontTypography="TitleLarge" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ui:TextBlock Text="{l:T programs.subtitle}" 
                              FontTypography="Body" Opacity="0.7" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                
                <!-- Category Tabs -->
                <ListBox ItemsSource="{Binding ViewModel.Categories}" 
                         SelectedItem="{Binding ViewModel.SelectedCategory}"
                         Margin="0,24,0,0"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,10"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="20" 
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocKeyConverter}}" 
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- Winget Status Indicator -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T programs.wingetStatus}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFC107" Opacity="0.8"/>
                    
                    <!-- Success State -->
                    <StackPanel Orientation="Horizontal" 
                                Visibility="{Binding ViewModel.IsWingetInstalled, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Page}}">
                         <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Foreground="#28A745" Margin="0,0,4,0"/>
                         <TextBlock Text="{l:T common.ready}" FontSize="11" FontWeight="Bold" Foreground="#28A745" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Error State -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ViewModel.IsWingetInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=Page}}">
                         <ui:SymbolIcon Symbol="DismissCircle24" FontSize="16" Foreground="#DC3545" Margin="0,0,4,0"/>
                         <TextBlock Text="{l:T common.missing}" FontSize="11" FontWeight="Bold" Foreground="#DC3545" VerticalAlignment="Center" Margin="0,0,8,0"/>
                         
                         <ui:Button Content="{l:T common.enableNow}" 
                                    FontSize="10" 
                                    Padding="8,2" 
                                    Appearance="Primary"
                                    Icon="{ui:SymbolIcon WrenchSettings24}"
                                    Command="{Binding ViewModel.EnableWingetCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Programs Grid -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <ItemsControl ItemsSource="{Binding ViewModel.Programs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="230" ItemHeight="300" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,12" 
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" 
                                CornerRadius="12"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Checkbox & Status -->
                                <Grid Grid.Row="0">
                                    <CheckBox IsChecked="{Binding IsSelected}" 
                                              IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}"
                                              Command="{Binding ViewModel.ToggleSelectCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                    
                                    <!-- Status Indicator -->
                                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                         <TextBlock Text="{l:B programs.installedBadge}" FontSize="10" FontWeight="Bold" Foreground="LimeGreen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                         <ui:SymbolIcon Symbol="CheckmarkCircle24" 
                                                        Foreground="LimeGreen" FontSize="18" Margin="0,0,8,0"/>
                                         
                                         <!-- Uninstall Button -->
                                         <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                                                    ToolTip="{l:B programs.uninstallTooltip}"
                                                    Appearance="Danger"
                                                    FontSize="10"
                                                    Padding="6,4"
                                                    Command="{Binding ViewModel.UninstallCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"/>
                                    </StackPanel>

                                </Grid>

                                <!-- Content -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <!-- Icon with Brand Color -->
                                    <Grid Width="64" Height="64" Margin="0,0,0,16">
                                        <Ellipse Fill="{Binding HexColor}" Opacity="0.15" />
                                        <ui:SymbolIcon Symbol="{Binding IconSymbol}" FontSize="32" 
                                                       Foreground="{Binding HexColor}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    
                                    <TextBlock Text="{Binding DescriptionKey, Converter={StaticResource LocKeyConverter}}" FontSize="12" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Footer Status Text -->
                                <TextBlock Grid.Row="2" Text="{Binding StatusKey, Converter={StaticResource LocKeyConverter}}" 
                                           HorizontalAlignment="Center" 
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           FontSize="11" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModel.StatusMessage}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ProgressBar Value="{Binding ViewModel.ProgressValue}" Height="4" Margin="0,8,0,0"
                                 Maximum="100"
                                 Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>

                <ui:Button Grid.Column="1" 
                           Content="{l:T programs.installSelected}" 
                           Icon="{ui:SymbolIcon ArrowDownload24}" 
                           Appearance="Primary"
                           Command="{Binding ViewModel.InstallCommand}"
                           IsEnabled="{Binding ViewModel.IsBusy, Converter={StaticResource InverseBooleanConverter}}"/> 
            </Grid>
        </Border>
    </Grid>
</Page>
