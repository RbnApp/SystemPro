<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <AssemblyName>RbnSystemPro</AssemblyName>
    <!-- Ürün kimliği — diğer Productions uygulamalarıyla aynı standart (Desk Helper package.json) -->
    <Company>rbnbilisim</Company>
    <Product>RbnSystemPro</Product>
    <Copyright>© 2026 rbnbilisim</Copyright>
    <Description>Windows kurulum sonrası bakım aracı: donanım özeti, sürücü durumu, winget ile program kurulumu, geçici dosya/önbellek temizliği ve ağ araçları — tek pencerede.</Description>
    <!-- Sürüm tek kaynak: Helpers\GlobalConfig.cs AppVersion = "0.1.3" (v öneki YOK, ANA.ARA.YAMA) -->
    <GlobalConfigText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Helpers\GlobalConfig.cs'))</GlobalConfigText>
    <VersionRegex>public const string AppVersion = &quot;([\d.]+)&quot;;</VersionRegex>
    <VersionRaw>$([System.Text.RegularExpressions.Regex]::Match($(GlobalConfigText), $(VersionRegex)).Groups[1].Value)</VersionRaw>
    <Version Condition="'$(VersionRaw)' != ''">$(VersionRaw)</Version>
    <Version Condition="'$(VersionRaw)' == ''">0.1.0</Version>
    <!-- Windows'ta görünen sürüm 0.1.3 olsun: dosya/ürün sürümü metni üç basamak, git eki yok. Yalnız AssemblyVersion .NET zorunluluğu olarak dört parçalıdır (ekranda görünmez). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <!-- Single File Publish Settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Simgeler (DAPP-36): app_icon.ico = 16/24/32/48/64/128/256 px çok boyutlu simge;
         app_icon.png = aynı çizimin 256 px hâli (belge/kısayol görselleri için). -->
    <Resource Include="Assets\app_icon.ico" />
    <Resource Include="Assets\app_icon.png" />
  </ItemGroup>



</Project>
